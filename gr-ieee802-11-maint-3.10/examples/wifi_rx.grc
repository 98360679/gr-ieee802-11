- id: epy_block
  name: ber_sink_0
  parameters:
    _source_code: "\"\"\"\nber_sink - live BER/FER for the FRID closed loop (per-frame-seeded payload).\n\nConsumes decode_mac 'out' (CRC-valid) on 'valid' and CRC-failed frames on\n'failed' (requires the patched ieee802_11 with the 'failed' port). BER is\ncomputed vs the KNOWN TX payload: FRID magic + per-frame [A-Za-z0-9] filler\nderived deterministically from (seed, frame_id) -- IDENTICAL to the TX block\nexp3_varied_payload_id in wifi_tx_varied.grc -- with the 4 id bytes excluded.\nThis makes a true BER possible even though the payload varies every frame.\nFailed frames whose per-frame match-BER >= noise_threshold are treated as noise\nfalse-syncs and discarded. Prints every report_sec, and a flushed FINAL summary\non stop(), so a timed/Ctrl-C run always ends with the cumulative BER.\n\nWhen ZERO bit errors are observed the reported BER is the theoretical 95% upper\nconfidence bound 2.996/N (rule of three), flagged '[0-err 95%UB]', not 0.\n\nNB: `seed` must equal the TX block's seed, and PDU_LENGTH its pdu_length.\n\"\"\"\nimport time\nimport struct\nimport pmt\nfrom gnuradio import gr\n\nMAC_HDR_LEN = 24\nMAGIC = b'FRID'\nPDU_LENGTH = 500\nFILL_LEN = PDU_LENGTH - 8\n_POPCOUNT = bytes(bin(i).count('1') for i in range(256))\n\n\n\n\nclass blk(gr.basic_block):\n    def __init__(self, report_sec=2.0, noise_threshold=0.30, seed=0):\n        gr.basic_block.__init__(self, name='ber_sink', in_sig=[], out_sig=[])\n        self.report_sec = float(report_sec)\n        self.noise_threshold = float(noise_threshold)\n        self.seed = int(seed)\n        self.valid = 0\n        self.failed = 0\n        self.discarded = 0\n        self.err_bits = 0\n        self.tot_bits = 0\n        self.ids = set()\n        self.id_min = None\n        self.id_max = None\n        self.t0 = time.time()\n        self.t_last = self.t0\n        self.message_port_register_in(pmt.intern('valid'))\n        self.message_port_register_in(pmt.intern('failed'))\n        self.set_msg_handler(pmt.intern('valid'), self.handle_valid)\n        self.set_msg_handler(pmt.intern('failed'), self.handle_failed)\n        # Startup filler fingerprint: must match the TX block's line exactly.\n        # A mismatch means TX and RX disagree on seed/scheme -> BER will be bogus.\n        fp = (b'x' * 8).decode()\n        print('[filler-fp] RX ber_sink seed=%d fp=%s' % (self.seed, fp), flush=True)\n\n    def handle_valid(self, msg):\n        self._handle(msg, True)\n\n    def handle_failed(self, msg):\n        self._handle(msg, False)\n\n    def _bit_errors(self, got, exp):\n        n = min(len(got), len(exp))\n        e = 0\n        for i in range(n):\n            e += _POPCOUNT[got[i] ^ exp[i]]\n        return e, n * 8\n\n    def _report(self, final=False):\n        now = time.time()\n        rx = self.valid + self.failed\n        # Measured BER, except when ZERO bit errors are observed: 0 errors does not\n        # prove BER==0, it only bounds it. Report the theoretical 95% upper\n        # confidence bound (rule of three: -ln(0.05)=2.996) => BER = 2.996 / N.\n        zero_ub = False\n        if self.tot_bits:\n            ber = self.err_bits / self.tot_bits\n            if self.err_bits == 0:\n                ber = 2.996 / self.tot_bits\n                zero_ub = True\n        else:\n            ber = 0.0\n        fer = self.failed / rx if rx else 0.0\n        tag = '[ber] FINAL' if final else '[ber]'\n        line = ('%s t=%5.1fs rx=%d (ok=%d fail=%d) noise-drop=%d FER_rx=%4.1f%% BER=%.2e%s (%d/%d)'\n                % (tag, now - self.t0, rx, self.valid, self.failed, self.discarded,\n                   100 * fer, ber, ' [0-err 95%UB]' if zero_ub else '',\n                   self.err_bits, self.tot_bits))\n        if self.ids:\n            span = self.id_max - self.id_min + 1\n            line += '  decode-rate=%4.1f%% (%d/%d)' % (100.0 * len(self.ids) / span, len(self.ids), span)\n        print(line, flush=True)\n        self.t_last = now\n\n    def _handle(self, msg, ok):\n        try:\n            data = bytes(pmt.u8vector_elements(pmt.cdr(msg)))\n        except Exception:\n            return\n        msdu = data[MAC_HDR_LEN:]\n        if len(msdu) < 8:\n            return\n        fid = struct.unpack('>I', msdu[4:8])[0]\n        exp_fill = b'x' * FILL_LEN\n        eb_m, tb_m = self._bit_errors(msdu[:4], MAGIC)\n        eb_f, tb_f = self._bit_errors(msdu[8:PDU_LENGTH], exp_fill)\n        eb = eb_m + eb_f\n        tb = tb_m + tb_f\n        if not ok:\n            frame_ber = eb / tb if tb else 1.0\n            if frame_ber >= self.noise_threshold:\n                self.discarded += 1\n                return\n        self.err_bits += eb\n        self.tot_bits += tb\n        if ok:\n            self.valid += 1\n            self.ids.add(fid)\n            self.id_min = fid if self.id_min is None else min(self.id_min, fid)\n            self.id_max = fid if self.id_max is None else max(self.id_max, fid)\n        else:\n            self.failed += 1\n        if time.time() - self.t_last >= self.report_sec:\n            self._report()\n\n    def stop(self):\n        # Called when the flowgraph stops (incl. SIGTERM from `timeout` and\n        # Ctrl-C): emit the cumulative FINAL BER, flushed so it is not lost.\n        print('\\n================ BER summary ================', flush=True)\n        self._report(final=True)\n        print('=============================================', flush=True)\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_threshold: '0.3'
    report_sec: '2.0'
    seed: '0'
  states:
    _io_cache: ('ber_sink', 'blk', [('report_sec', '2.0'), ('noise_threshold', '0.3'), ('seed', '0')], [('valid', 'message', 1), ('failed', 'message', 1)], [], '', ['noise_threshold', 'report_sec', 'seed'])
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate:
    - 352
    - 568.0
    rotation: 180
    state: enabled
